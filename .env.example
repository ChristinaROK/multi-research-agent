# multi-research-agent — 환경변수 템플릿
# 이 파일은 커밋됨. 실제 값은 .env 에 넣고 .env 는 절대 커밋 금지.

# ─── Claude API ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# 모델 분담 (필요 시 오버라이드, 미설정 시 코드 기본값 사용)
# MODEL_SUPERVISOR=claude-haiku-4-5
# MODEL_HYPOTHESIS=claude-opus-4-7
# MODEL_COLLECTOR=claude-sonnet-4-6
# MODEL_ANALYZER=claude-opus-4-7
# MODEL_VERIFIER=claude-sonnet-4-6
# MODEL_MONITOR=claude-haiku-4-5

# ─── 외부 데이터 소스 (필요한 에이전트만 사용) ───────────────
# DART (전자공시) — Collector 에이전트 전용
DART_API_KEY=

# KCGS (지배구조원) — Collector 전용, 로그인 기반
KCGS_USERNAME=
KCGS_PASSWORD=

# KOSIS (통계청) — Collector 전용 (옵션)
# KOSIS_API_KEY=

# ─── 알림 채널 (Telegram) ────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# 등급별 채널 분리 — info(조용), warn(참고), urgent(밤에 깨워도 OK)
TELEGRAM_CHAT_INFO=
TELEGRAM_CHAT_WARN=
TELEGRAM_CHAT_URGENT=

# ─── 운영 한도 (Cost / Time circuit breaker) ─────────────────
# 핸드오버 §6 — 4중 안전장치
MAX_COST_USD_PER_HOUR=10
MAX_COST_USD_PER_DAY=50
MAX_COST_USD_CUMULATIVE=200
MAX_RUN_HOURS=8

# 정지 조건: 최근 N개 verdict 중 K개 이상 rejected → diminishing returns
DIMINISHING_RETURNS_WINDOW=10
DIMINISHING_RETURNS_REJECT_THRESHOLD=8

# 가설 폭발 방지 (§3-5)
MAX_HYPOTHESIS_DEPTH=3
MAX_NEW_HYPOTHESES_PER_CYCLE=5

# 데드락 방지 (§3-8)
MAX_TASK_AGE_HOURS=4

# Supervisor 폴링 주기 (초)
POLL_INTERVAL_SEC=30

# ─── 실행 모드 ───────────────────────────────────────────────
# dry_run | live
RUN_MODE=dry_run

# 로그 레벨
LOG_LEVEL=INFO
